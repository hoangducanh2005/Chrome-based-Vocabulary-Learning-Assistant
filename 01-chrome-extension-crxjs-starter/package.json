{
    "name": "hoidanit-extension",
    "type": "module",
    "version": "1.0.0",
    "private": true,
    "author": {
        "name": "Hỏi Dân IT @hoidanit",
        "url": "https://hoidanit.vn"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write src",
        "type-check": "tsc --noEmit -p tsconfig.app.json"
    },
    "dependencies": {
        "react": "19.2.5",
        "react-dom": "19.2.5"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "2.4.0",
        "@tailwindcss/vite": "4.2.4",
        "@types/chrome": "0.1.40",
        "@types/node": "25.6.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.1",
        "eslint": "10.2.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.5.0",
        "prettier": "3.8.3",
        "tailwindcss": "4.2.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.59.0",
        "vite": "8.0.10",
        "vite-plugin-zip-pack": "1.2.4"
    }
}